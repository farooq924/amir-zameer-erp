# ---------------------------------------------------------------
# AMIR ZAMEER ERP - environment template
# Copy to apps/backend/.env (local) or .env (docker) and fill in.
# NEVER commit real values.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://az_erp:change_me@localhost:5432/amir_zameer_erp?schema=public&connection_limit=10
POSTGRES_USER=az_erp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=amir_zameer_erp

# Sessions & security
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# Set to true in production (HTTPS)
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# First owner account (used only by the seed script, only if no owner exists yet)
OWNER_NAME=Amir Zameer
OWNER_EMAIL=owner@amirzameer.com
OWNER_USERNAME=owner
OWNER_PASSWORD=ChangeThisStrongPassword!2026

# WhatsApp Cloud API (Phase 8 - optional)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Backups (Phase 10)
# Folder for encrypted .azbak backups. Empty = <project folder>/backups
BACKUP_DIR=
# Backup encryption key (min 16 characters). Empty = a random key is created in apps/backend/backup.key
# (download it once from Backup > Download recovery key and keep it safe).
BACKUP_ENCRYPTION_KEY=
# Folder with pg_dump / pg_restore. Empty = found automatically (C:\Program Files\PostgreSQL\<newest>\bin on Windows)
PG_BIN_DIR=
