{
  "name": "@az/backend",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --runInBand --selectProjects e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:seed:prod": "node dist/modules/platform/seed-cli.js",
    "demo:load": "node dist/demo/cli.js load",
    "demo:remove": "node dist/demo/cli.js remove",
    "demo:status": "node dist/demo/cli.js status",
    "demo:dev": "ts-node --transpile-only src/demo/cli.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@az/shared": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
    "pdfkit": "0.17.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.0",
    "@types/pdfkit": "0.17.3",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
