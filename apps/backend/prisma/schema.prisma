// -----------------------------------------------------------------------------
// SAAS PLATFORM (TailoringERP By Brandistan): companies (tenants), plans, billing
// Every business table carries "companyId". The Prisma client extension in
// src/common/tenant adds it to every query automatically, so one company can
// never read or change another company's data.
// NOTE: companyId columns are plain scalars on purpose (no Prisma relation);
// their foreign keys to "companies" are created in the SQL migration.
// -----------------------------------------------------------------------------

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(30)
  name         String   @db.VarChar(80)
  description  String?
  monthlyPrice Decimal  @default(0) @db.Decimal(14, 2)
  maxUsers     Int      @default(5)
  modules      String[] // module keys included in this plan (core modules are always included)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies Company[]

  @@map("plans")
}

model Company {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique @db.VarChar(30) // short id, e.g. "zameer-ansari"
  name            String        @db.VarChar(160)
  ownerName       String?       @db.VarChar(120)
  phone           String?       @db.VarChar(30)
  email           String?       @db.VarChar(160)
  address         String?
  city            String?       @db.VarChar(80)
  docPrefix       String        @default("AZ") @db.VarChar(6) // document number prefix (orders, receipts ...)
  status          CompanyStatus @default(TRIAL)
  planId          String        @db.Uuid
  trialEndsAt     DateTime?
  paidUntil       DateTime? // null while ACTIVE = no expiry
  graceDays       Int           @default(7)
  notes           String?
  suspendedReason String?       @db.VarChar(300)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  plan     Plan             @relation(fields: [planId], references: [id])
  payments CompanyPayment[]

  @@index([status])
  @@map("companies")
}

model CompanyPayment {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  amount       Decimal  @db.Decimal(14, 2)
  months       Int      @default(1)
  method       String   @db.VarChar(20) // JAZZCASH | EASYPAISA | BANK | CASH | OTHER
  reference    String?  @db.VarChar(120)
  paidAt       DateTime @db.Date
  periodFrom   DateTime @db.Date
  periodTo     DateTime @db.Date
  notes        String?
  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, paidAt])
  @@map("company_payments")
}

/// Platform-wide settings (not per company), e.g. backup configuration.
model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

// -----------------------------------------------------------------------------
// AUTHENTICATION & RBAC
// -----------------------------------------------------------------------------

model User {
  companyId           String?   @db.Uuid // tenant (company) - set automatically, see common/tenant
  id                  String    @id @default(uuid()) @db.Uuid
  fullName            String    @db.VarChar(120)
  email               String    @unique @db.VarChar(160)
  username            String    @unique @db.VarChar(60)
  passwordHash        String
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  isSuperAdmin        Boolean   @default(false) // TailoringERP platform admin (companyId is null)
  employeeId          String?   @unique @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  employee              Employee?             @relation(fields: [employeeId], references: [id])
  roles                 UserRole[]            @relation("UserRoles")
  rolesAssigned         UserRole[]            @relation("UserRoleAssignedBy")
  sessions              Session[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  syncOperations        SyncOperation[]
  attachments           Attachment[]
  ordersCreated         Order[]               @relation("OrderCreatedBy")
  statusChanges         OrderStatusHistory[]
  measurementsCreated   CustomerMeasurement[]
  inventoryMovements    InventoryMovement[]
  paymentsCreated       Payment[]
  expensesCreated       Expense[]             @relation("ExpenseCreatedBy")
  expensesApproved      Expense[]             @relation("ExpenseApprovedBy")
  journalEntriesCreated JournalEntry[]        @relation("JournalCreatedBy")
  journalEntriesPosted  JournalEntry[]        @relation("JournalPostedBy")
  payrollsApproved      Payroll[]
  backups               BackupRecord[]
  settingsUpdated       SystemSetting[]

  @@index([companyId])
  @@map("users")
}

model Role {
  companyId   String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80) // e.g. "customers.view"
  module      String           @db.VarChar(40)
  action      PermissionAction
  description String?

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  companyId    String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  assignedById String?  @db.Uuid
  assignedAt   DateTime @default(now())

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id])

  @@id([userId, roleId])
  @@index([companyId])
  @@map("user_roles")
}

model RolePermission {
  companyId    String @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([companyId])
  @@map("role_permissions")
}

model Session {
  companyId       String?   @db.Uuid // tenant (company) - set automatically, see common/tenant
  id              String    @id @default(uuid()) @db.Uuid
  tokenHash       String    @unique @db.VarChar(128) // SHA-256 of the cookie token; raw token is never stored
  csrfToken       String    @db.VarChar(128)
  userId          String    @db.Uuid
  ipAddress       String?   @db.VarChar(64)
  userAgent       String?   @db.VarChar(400)
  deviceId        String?   @db.VarChar(100)
  actingCompanyId String?   @db.Uuid // super admin "login as" a company (support access)
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([companyId])
  @@map("sessions")
}

model LoginAttempt {
  companyId  String?  @db.Uuid // tenant (company) - set automatically, see common/tenant
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.VarChar(160)
  ipAddress  String?  @db.VarChar(64)
  success    Boolean
  reason     String?  @db.VarChar(80)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
  @@index([companyId])
  @@map("login_attempts")
}

// -----------------------------------------------------------------------------
// SYSTEM: SETTINGS, SEQUENCES, AUDIT, NOTIFICATIONS, FILES, SYNC, BACKUP
// -----------------------------------------------------------------------------

model SystemSetting {
  companyId   String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  key         String   @db.VarChar(100)
  group       String   @db.VarChar(40)
  value       Json
  description String?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@id([companyId, key])
  @@index([group])
  @@map("system_settings")
}

/// Gap-free, transaction-safe document numbers, e.g. AZ-2026-00001.
model NumberSequence {
  companyId String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @db.VarChar(40) // ORDER, CUSTOMER, RECEIPT, EXPENSE ...
  period    String   @default("") @db.VarChar(10) // "2026" for yearly sequences, "" for global
  prefix    String   @db.VarChar(20)
  padding   Int      @default(5)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([companyId, key, period])
  @@index([companyId])
  @@map("number_sequences")
}

/// Append-only. UPDATE/DELETE are blocked by a database trigger.
model AuditLog {
  companyId String?  @db.Uuid // tenant (company) - set automatically, see common/tenant
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String   @db.VarChar(60)
  module    String   @db.VarChar(40)
  recordId  String?  @db.VarChar(80)
  oldValues Json?
  newValues Json?
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(400)
  sessionId String?  @db.Uuid
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([module, createdAt])
  @@index([userId, createdAt])
  @@index([recordId])
  @@index([createdAt])
  @@index([companyId])
  @@map("audit_logs")
}

model Notification {
  companyId String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid // null = broadcast to owner/admins
  type      String   @db.VarChar(40)
  title     String   @db.VarChar(160)
  message   String
  link      String?  @db.VarChar(300)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([companyId])
  @@map("notifications")
}

model Attachment {
  companyId    String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id           String   @id @default(uuid()) @db.Uuid
  entityType   String   @db.VarChar(40)
  entityId     String   @db.Uuid
  fileName     String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  sizeBytes    Int
  storagePath  String   @db.VarChar(500)
  checksum     String   @db.VarChar(128)
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@index([companyId])
  @@map("attachments")
}

/// Idempotency keys for non-sync API calls that create financial / stock records.
model IdempotencyKey {
  companyId      String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  key            String   @id @db.VarChar(100)
  userId         String?  @db.Uuid
  endpoint       String   @db.VarChar(200)
  requestHash    String   @db.VarChar(128)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
  @@index([companyId])
  @@map("idempotency_keys")
}

/// Every offline operation pushed by a client. `id` is the client-generated operation id,
/// so re-sending the same operation can never apply it twice.
model SyncOperation {
  companyId       String     @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id              String     @id @db.Uuid
  deviceId        String     @db.VarChar(100)
  userId          String?    @db.Uuid
  entityType      String     @db.VarChar(40)
  entityId        String     @db.Uuid
  operation       String     @db.VarChar(20) // CREATE | UPDATE | DELETE | ACTION
  baseVersion     Int?
  payload         Json
  status          SyncStatus @default(PENDING)
  result          Json?
  errorMessage    String?
  clientTimestamp DateTime
  serverTimestamp DateTime   @default(now())

  user      User?          @relation(fields: [userId], references: [id])
  conflicts SyncConflict[]

  @@index([deviceId, serverTimestamp])
  @@index([entityType, entityId])
  @@index([status])
  @@index([companyId])
  @@map("sync_operations")
}

model SyncConflict {
  companyId       String             @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id              String             @id @default(uuid()) @db.Uuid
  syncOperationId String             @db.Uuid
  entityType      String             @db.VarChar(40)
  entityId        String             @db.Uuid
  serverVersion   Int
  clientVersion   Int?
  serverData      Json
  clientData      Json
  resolution      ConflictResolution @default(PENDING)
  resolvedById    String?            @db.Uuid
  resolvedAt      DateTime?
  notes           String?
  createdAt       DateTime           @default(now())

  syncOperation SyncOperation @relation(fields: [syncOperationId], references: [id], onDelete: Cascade)

  @@index([resolution])
  @@index([companyId])
  @@map("sync_conflicts")
}

model BackupRecord {
  id             String       @id @default(uuid()) @db.Uuid
  fileName       String       @db.VarChar(255)
  storagePath    String       @db.VarChar(500)
  externalPath   String?      @db.VarChar(500)
  sizeBytes      BigInt?
  checksumSha256 String?      @db.VarChar(64)
  encrypted      Boolean      @default(true)
  type           BackupType
  status         BackupStatus @default(RUNNING)
  verifiedAt     DateTime?
  restoredAt     DateTime?
  errorMessage   String?
  createdById    String?      @db.Uuid
  startedAt      DateTime     @default(now())
  completedAt    DateTime?

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([startedAt])
  @@map("backup_records")
}

// -----------------------------------------------------------------------------
// CUSTOMERS
// -----------------------------------------------------------------------------

model Customer {
  companyId        String         @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id               String         @id @default(uuid()) @db.Uuid
  code             String         @db.VarChar(20) // AZC-00001
  name             String         @db.VarChar(120)
  mobile           String         @db.VarChar(20) // normalised E.164-ish, e.g. 923001234567
  whatsapp         String?        @db.VarChar(20)
  email            String?        @db.VarChar(160)
  city             String?        @db.VarChar(80)
  customerType     CustomerType   @default(REGULAR)
  registrationDate DateTime       @default(now()) @db.Date
  notes            String?
  status           CustomerStatus @default(ACTIVE)
  openingBalance   Decimal        @default(0) @db.Decimal(14, 2)
  whatsappOptIn    Boolean        @default(false)
  whatsappOptInAt  DateTime?
  version          Int            @default(1)
  createdById      String?        @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  addresses     CustomerAddress[]
  customerNotes CustomerNote[]
  measurements  CustomerMeasurement[]
  orders        Order[]
  payments      Payment[]
  ledger        CustomerLedger[]
  saleReturns   SaleReturn[]
  messages      WhatsAppMessage[]
  journalLines  JournalEntryLine[]

  @@unique([companyId, code])
  @@index([mobile])
  @@index([whatsapp])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_trgm_idx")
  @@index([status])
  @@index([companyId])
  @@map("customers")
}

model CustomerAddress {
  companyId   String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  label       String   @default("Home") @db.VarChar(40)
  addressLine String   @db.VarChar(300)
  city        String?  @db.VarChar(80)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([companyId])
  @@map("customer_addresses")
}

model CustomerNote {
  companyId   String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  note        String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([companyId])
  @@map("customer_notes")
}

// -----------------------------------------------------------------------------
// MEASUREMENTS (versioned, never overwritten)
// -----------------------------------------------------------------------------

model MeasurementTemplate {
  companyId       String          @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id              String          @id @default(uuid()) @db.Uuid
  code            String          @db.VarChar(40)
  name            String          @db.VarChar(80)
  garmentCategory GarmentCategory
  defaultUnit     MeasurementUnit @default(INCH)
  isSystem        Boolean         @default(false)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  fields       MeasurementField[]
  measurements CustomerMeasurement[]
  garmentTypes GarmentType[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("measurement_templates")
}

model MeasurementField {
  companyId  String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid
  key        String   @db.VarChar(40) // e.g. "chest"
  label      String   @db.VarChar(60) // e.g. "Chest"
  sortOrder  Int      @default(0)
  isRequired Boolean  @default(false)
  minValue   Decimal? @db.Decimal(7, 2)
  maxValue   Decimal? @db.Decimal(7, 2)
  isActive   Boolean  @default(true)

  template MeasurementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  values   MeasurementValue[]

  @@unique([templateId, key])
  @@index([companyId])
  @@map("measurement_fields")
}

/// One immutable version of a customer's measurements for one template.
model CustomerMeasurement {
  companyId   String          @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id          String          @id @default(uuid()) @db.Uuid
  customerId  String          @db.Uuid
  templateId  String          @db.Uuid
  versionNo   Int
  unit        MeasurementUnit @default(INCH)
  isLatest    Boolean         @default(true)
  takenAt     DateTime        @default(now())
  takenByName String?         @db.VarChar(120)
  notes       String?
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())

  customer  Customer             @relation(fields: [customerId], references: [id])
  template  MeasurementTemplate  @relation(fields: [templateId], references: [id])
  createdBy User?                @relation(fields: [createdById], references: [id])
  values    MeasurementValue[]
  orderUses GarmentMeasurement[]

  @@unique([customerId, templateId, versionNo])
  @@index([customerId, templateId, isLatest])
  @@index([companyId])
  @@map("customer_measurements")
}

model MeasurementValue {
  companyId     String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id            String   @id @default(uuid()) @db.Uuid
  measurementId String   @db.Uuid
  fieldId       String?  @db.Uuid // null for custom one-off fields
  fieldKey      String   @db.VarChar(40)
  fieldLabel    String   @db.VarChar(60)
  value         Decimal? @db.Decimal(7, 2)
  textValue     String?  @db.VarChar(200)

  measurement CustomerMeasurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  field       MeasurementField?   @relation(fields: [fieldId], references: [id])

  @@unique([measurementId, fieldKey])
  @@index([companyId])
  @@map("measurement_values")
}

// -----------------------------------------------------------------------------
// GARMENTS, ORDERS & WORKFLOW
// -----------------------------------------------------------------------------

model GarmentType {
  companyId                String          @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id                       String          @id @default(uuid()) @db.Uuid
  code                     String          @db.VarChar(40)
  name                     String          @db.VarChar(80)
  category                 GarmentCategory
  measurementTemplateId    String?         @db.Uuid
  defaultStitchingPrice    Decimal         @default(0) @db.Decimal(14, 2)
  defaultFabricConsumption Decimal         @default(0) @db.Decimal(12, 3)
  defaultPieceRate         Decimal         @default(0) @db.Decimal(14, 2)
  isActive                 Boolean         @default(true)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  measurementTemplate MeasurementTemplate? @relation(fields: [measurementTemplateId], references: [id])
  orderItems          OrderItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("garments")
}

/// Configurable production workflow stages (New Order ... Delivered / Cancelled).
model WorkflowStage {
  companyId  String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @db.VarChar(40)
  name       String   @db.VarChar(60)
  sortOrder  Int
  color      String   @default("slate") @db.VarChar(20)
  isTerminal Boolean  @default(false) // Delivered, Cancelled
  isSystem   Boolean  @default(false) // system stages cannot be deleted
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders      Order[]
  orderItems  OrderItem[]
  historyFrom OrderStatusHistory[] @relation("HistoryFrom")
  historyTo   OrderStatusHistory[] @relation("HistoryTo")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("workflow_stages")
}

model Order {
  companyId            String         @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id                   String         @id @default(uuid()) @db.Uuid
  orderNumber          String         @db.VarChar(30) // AZ-2026-00001
  customerId           String         @db.Uuid
  orderType            OrderType      @default(STITCHING)
  orderDate            DateTime       @default(now()) @db.Date
  expectedDeliveryDate DateTime?      @db.Date
  actualDeliveryDate   DateTime?      @db.Date
  stageId              String         @db.Uuid
  lifecycle            OrderLifecycle @default(OPEN)
  paymentStatus        PaymentStatus  @default(UNPAID)
  stitchingTotal       Decimal        @default(0) @db.Decimal(14, 2)
  fabricTotal          Decimal        @default(0) @db.Decimal(14, 2)
  additionalCharges    Decimal        @default(0) @db.Decimal(14, 2)
  discount             Decimal        @default(0) @db.Decimal(14, 2)
  subtotal             Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount          Decimal        @default(0) @db.Decimal(14, 2)
  adjustmentsTotal     Decimal        @default(0) @db.Decimal(14, 2)
  paidAmount           Decimal        @default(0) @db.Decimal(14, 2)
  balanceAmount        Decimal        @default(0) @db.Decimal(14, 2)
  assignedEmployeeId   String?        @db.Uuid
  specialInstructions  String?
  revisionNo           Int            @default(0)
  duplicatedFromId     String?        @db.Uuid
  cancelledAt          DateTime?
  cancelReason         String?
  version              Int            @default(1)
  createdById          String?        @db.Uuid
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  customer         Customer             @relation(fields: [customerId], references: [id])
  stage            WorkflowStage        @relation(fields: [stageId], references: [id])
  assignedEmployee Employee?            @relation("OrderAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  duplicatedFrom   Order?               @relation("OrderDuplicate", fields: [duplicatedFromId], references: [id])
  duplicates       Order[]              @relation("OrderDuplicate")
  createdBy        User?                @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
  deliveries       OrderDelivery[]
  adjustments      OrderAdjustment[]
  payments         Payment[]
  reservations     StockReservation[]
  saleReturns      SaleReturn[]

  @@unique([companyId, orderNumber])
  @@index([customerId])
  @@index([orderDate])
  @@index([stageId])
  @@index([lifecycle])
  @@index([expectedDeliveryDate])
  @@index([orderNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_number_trgm_idx")
  @@index([companyId])
  @@map("orders")
}

model OrderItem {
  companyId          String       @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id                 String       @id @default(uuid()) @db.Uuid
  orderId            String       @db.Uuid
  lineNo             Int
  garmentTypeId      String?      @db.Uuid
  garmentName        String       @db.VarChar(100)
  quantity           Int
  fabricSource       FabricSource @default(CUSTOMER)
  fabricId           String?      @db.Uuid
  fabricDescription  String?      @db.VarChar(200)
  fabricPerPiece     Decimal      @default(0) @db.Decimal(12, 3)
  fabricQuantity     Decimal      @default(0) @db.Decimal(12, 3)
  fabricRate         Decimal      @default(0) @db.Decimal(14, 2)
  fabricAmount       Decimal      @default(0) @db.Decimal(14, 2)
  stitchingPrice     Decimal      @default(0) @db.Decimal(14, 2)
  stitchingAmount    Decimal      @default(0) @db.Decimal(14, 2)
  additionalCharges  Decimal      @default(0) @db.Decimal(14, 2)
  lineTotal          Decimal      @default(0) @db.Decimal(14, 2)
  stageId            String       @db.Uuid
  assignedEmployeeId String?      @db.Uuid
  deliveredQuantity  Int          @default(0)
  notes              String?
  version            Int          @default(1)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  garmentType       GarmentType?         @relation(fields: [garmentTypeId], references: [id])
  fabric            Fabric?              @relation(fields: [fabricId], references: [id])
  stage             WorkflowStage        @relation(fields: [stageId], references: [id])
  assignedEmployee  Employee?            @relation("OrderItemAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  measurement       GarmentMeasurement?
  statusHistory     OrderStatusHistory[]
  assignments       EmployeeAssignment[]
  productionRecords ProductionRecord[]
  reservations      StockReservation[]
  deliveryItems     OrderDeliveryItem[]

  @@unique([orderId, lineNo])
  @@index([assignedEmployeeId])
  @@index([stageId])
  @@index([companyId])
  @@map("order_items")
}

/// Frozen copy of the measurements used for one order item.
model GarmentMeasurement {
  companyId           String          @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id                  String          @id @default(uuid()) @db.Uuid
  orderItemId         String          @unique @db.Uuid
  sourceMeasurementId String?         @db.Uuid
  templateName        String          @db.VarChar(80)
  unit                MeasurementUnit
  values              Json // [{ key, label, value }]
  notes               String?
  createdAt           DateTime        @default(now())

  orderItem         OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  sourceMeasurement CustomerMeasurement? @relation(fields: [sourceMeasurementId], references: [id])

  @@index([companyId])
  @@map("garment_measurements")
}

model OrderStatusHistory {
  companyId   String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  orderItemId String?  @db.Uuid // null = whole-order change
  fromStageId String?  @db.Uuid
  toStageId   String   @db.Uuid
  notes       String?
  changedById String?  @db.Uuid
  changedAt   DateTime @default(now())

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  fromStage WorkflowStage? @relation("HistoryFrom", fields: [fromStageId], references: [id])
  toStage   WorkflowStage  @relation("HistoryTo", fields: [toStageId], references: [id])
  changedBy User?          @relation(fields: [changedById], references: [id])

  @@index([orderId, changedAt])
  @@index([companyId])
  @@map("order_status_history")
}

model OrderDelivery {
  companyId   String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  deliveryNo  Int
  deliveredAt DateTime @default(now())
  receivedBy  String?  @db.VarChar(120)
  notes       String?
  createdById String?  @db.Uuid

  order Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items OrderDeliveryItem[]

  @@unique([orderId, deliveryNo])
  @@index([companyId])
  @@map("order_deliveries")
}

model OrderDeliveryItem {
  companyId   String @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id          String @id @default(uuid()) @db.Uuid
  deliveryId  String @db.Uuid
  orderItemId String @db.Uuid
  quantity    Int

  delivery  OrderDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id])

  @@unique([deliveryId, orderItemId])
  @@index([companyId])
  @@map("order_delivery_items")
}

/// Authorised financial adjustments (the only way to change a delivered order's value).
model OrderAdjustment {
  companyId    String              @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id           String              @id @default(uuid()) @db.Uuid
  orderId      String              @db.Uuid
  type         OrderAdjustmentType
  amount       Decimal             @db.Decimal(14, 2) // signed: + increases balance, - decreases
  reason       String
  approvedById String?             @db.Uuid
  createdById  String?             @db.Uuid
  createdAt    DateTime            @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([companyId])
  @@map("order_adjustments")
}

// -----------------------------------------------------------------------------
// PRODUCTION
// -----------------------------------------------------------------------------

model EmployeeAssignment {
  companyId        String           @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id               String           @id @default(uuid()) @db.Uuid
  orderItemId      String           @db.Uuid
  employeeId       String           @db.Uuid
  taskType         TaskType         @default(STITCHING)
  assignedQuantity Int
  pieceRate        Decimal          @default(0) @db.Decimal(14, 2)
  status           AssignmentStatus @default(ASSIGNED)
  assignedAt       DateTime         @default(now())
  dueDate          DateTime?        @db.Date
  assignedById     String?          @db.Uuid
  notes            String?

  orderItem         OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  employee          Employee           @relation(fields: [employeeId], references: [id])
  productionRecords ProductionRecord[]

  @@index([employeeId, status])
  @@index([orderItemId])
  @@index([companyId])
  @@map("employee_assignments")
}

model ProductionRecord {
  companyId          String    @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id                 String    @id @default(uuid()) @db.Uuid
  assignmentId       String    @db.Uuid
  employeeId         String    @db.Uuid
  orderItemId        String    @db.Uuid
  workDate           DateTime  @db.Date
  startedAt          DateTime?
  completedAt        DateTime?
  completedQuantity  Int       @default(0)
  rejectedQuantity   Int       @default(0)
  alterationQuantity Int       @default(0)
  pieceRate          Decimal   @default(0) @db.Decimal(14, 2)
  amount             Decimal   @default(0) @db.Decimal(14, 2)
  payrollItemId      String?   @db.Uuid // set once paid, prevents paying the same pieces twice
  notes              String?
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now())

  assignment  EmployeeAssignment @relation(fields: [assignmentId], references: [id])
  employee    Employee           @relation(fields: [employeeId], references: [id])
  orderItem   OrderItem          @relation(fields: [orderItemId], references: [id])
  payrollItem PayrollItem?       @relation(fields: [payrollItemId], references: [id])

  @@index([employeeId, workDate])
  @@index([payrollItemId])
  @@index([companyId])
  @@map("production_records")
}

// -----------------------------------------------------------------------------
// FABRIC INVENTORY
// -----------------------------------------------------------------------------

model FabricCategory {
  companyId   String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(80)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fabrics Fabric[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("fabric_categories")
}

model Fabric {
  companyId     String     @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id            String     @id @default(uuid()) @db.Uuid
  code          String     @db.VarChar(30)
  name          String     @db.VarChar(120)
  brand         String?    @db.VarChar(80)
  categoryId    String?    @db.Uuid
  color         String?    @db.VarChar(60)
  design        String?    @db.VarChar(80)
  quality       String?    @db.VarChar(80)
  supplierId    String?    @db.Uuid
  purchasePrice Decimal    @default(0) @db.Decimal(14, 2)
  salePrice     Decimal    @default(0) @db.Decimal(14, 2)
  unit          FabricUnit @default(METER)
  minimumStock  Decimal    @default(0) @db.Decimal(12, 3)
  currentStock  Decimal    @default(0) @db.Decimal(12, 3) // maintained only through inventory_movements
  reservedStock Decimal    @default(0) @db.Decimal(12, 3)
  averageCost   Decimal    @default(0) @db.Decimal(14, 4)
  location      String?    @db.VarChar(80)
  isActive      Boolean    @default(true)
  version       Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  category            FabricCategory?      @relation(fields: [categoryId], references: [id])
  supplier            Supplier?            @relation(fields: [supplierId], references: [id])
  movements           InventoryMovement[]
  reservations        StockReservation[]
  orderItems          OrderItem[]
  purchaseItems       PurchaseItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleReturnItems     SaleReturnItem[]

  @@unique([companyId, code])
  @@index([name])
  @@index([categoryId])
  @@index([companyId])
  @@map("fabrics")
}

/// Inventory ledger. Every stock change is one row; `idempotencyKey` makes duplicate deductions impossible.
model InventoryMovement {
  companyId      String            @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id             String            @id @default(uuid()) @db.Uuid
  movementNo     String            @db.VarChar(30)
  fabricId       String            @db.Uuid
  type           MovementType
  direction      MovementDirection
  quantity       Decimal           @db.Decimal(12, 3) // always positive
  unitCost       Decimal           @default(0) @db.Decimal(14, 4)
  totalCost      Decimal           @default(0) @db.Decimal(14, 2)
  balanceAfter   Decimal           @db.Decimal(12, 3)
  location       String?           @db.VarChar(80)
  referenceType  String?           @db.VarChar(40)
  referenceId    String?           @db.Uuid
  idempotencyKey String            @unique @db.VarChar(120)
  reason         String?
  movementDate   DateTime          @default(now())
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now())

  fabric    Fabric @relation(fields: [fabricId], references: [id])
  createdBy User?  @relation(fields: [createdById], references: [id])

  @@unique([companyId, movementNo])
  @@index([fabricId, movementDate])
  @@index([referenceType, referenceId])
  @@index([type, movementDate])
  @@index([companyId])
  @@map("inventory_movements")
}

model StockReservation {
  companyId   String            @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id          String            @id @default(uuid()) @db.Uuid
  fabricId    String            @db.Uuid
  orderId     String            @db.Uuid
  orderItemId String            @db.Uuid
  quantity    Decimal           @db.Decimal(12, 3)
  consumed    Decimal           @default(0) @db.Decimal(12, 3)
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  closedAt    DateTime?

  fabric    Fabric    @relation(fields: [fabricId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([orderItemId, fabricId])
  @@index([fabricId, status])
  @@index([companyId])
  @@map("stock_reservations")
}

model SaleReturn {
  companyId   String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id          String   @id @default(uuid()) @db.Uuid
  returnNo    String   @db.VarChar(30)
  orderId     String?  @db.Uuid
  customerId  String   @db.Uuid
  returnDate  DateTime @default(now()) @db.Date
  totalAmount Decimal  @db.Decimal(14, 2)
  reason      String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  order    Order?           @relation(fields: [orderId], references: [id])
  customer Customer         @relation(fields: [customerId], references: [id])
  items    SaleReturnItem[]

  @@unique([companyId, returnNo])
  @@index([companyId])
  @@map("sale_returns")
}

model SaleReturnItem {
  companyId    String  @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id           String  @id @default(uuid()) @db.Uuid
  saleReturnId String  @db.Uuid
  fabricId     String  @db.Uuid
  quantity     Decimal @db.Decimal(12, 3)
  rate         Decimal @db.Decimal(14, 2)
  amount       Decimal @db.Decimal(14, 2)

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  fabric     Fabric     @relation(fields: [fabricId], references: [id])

  @@index([companyId])
  @@map("sale_return_items")
}

// -----------------------------------------------------------------------------
// SUPPLIERS & PURCHASES
