// =============================================================================
// AMIR ZAMEER ERP - PostgreSQL schema (Prisma)
// Conventions:
//   * Primary keys are UUIDs so offline clients can generate IDs safely.
//   * Money          -> Decimal(14,2)   (never floating point)
//   * Unit costs     -> Decimal(14,4)
//   * Fabric qty     -> Decimal(12,3)
//   * Measurements   -> Decimal(7,2)
//   * Table names are snake_case plural (@@map); columns are camelCase.
//   * Sync-able records carry `version` (optimistic concurrency) and `deletedAt` (soft delete).
//   * Extra CHECK constraints, triggers (immutable audit log, balanced and
//     immutable posted journal entries) live in the SQL migrations.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

