// -----------------------------------------------------------------------------
// EMPLOYEES, ATTENDANCE & PAYROLL
// -----------------------------------------------------------------------------

model Employee {
  companyId         String         @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id                String         @id @default(uuid()) @db.Uuid
  code              String         @db.VarChar(20) // AZE-0001
  name              String         @db.VarChar(120)
  fatherName        String?        @db.VarChar(120)
  contactNumber     String?        @db.VarChar(20)
  address           String?        @db.VarChar(300)
  cnic              String?        @db.VarChar(15) // 12345-1234567-1
  joiningDate       DateTime       @db.Date
  leavingDate       DateTime?      @db.Date
  designation       String?        @db.VarChar(80)
  employeeType      EmployeeType
  employmentType    EmploymentType @default(PERMANENT)
  bankName          String?        @db.VarChar(80)
  bankAccountTitle  String?        @db.VarChar(120)
  bankAccountNumber String?        @db.VarChar(40)
  status            EmployeeStatus @default(ACTIVE)
  notes             String?
  version           Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  user               User?
  salaryStructures   SalaryStructure[]
  employmentHistory  EmploymentHistory[]
  attendance         Attendance[]
  leaves             LeaveRecord[]
  overtime           OvertimeRecord[]
  advances           EmployeeAdvance[]
  payrollItems       PayrollItem[]
  salaryPayments     SalaryPayment[]
  assignments        EmployeeAssignment[]
  productionRecords  ProductionRecord[]
  ordersAssigned     Order[]              @relation("OrderAssignedEmployee")
  orderItemsAssigned OrderItem[]          @relation("OrderItemAssignedEmployee")
  journalLines       JournalEntryLine[]

  @@unique([companyId, code])
  @@unique([companyId, cnic])
  @@index([name])
  @@index([status])
  @@index([companyId])
  @@map("employees")
}

/// Salary history: a new row per change, never edited in place.
model SalaryStructure {
  companyId           String     @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id                  String     @id @default(uuid()) @db.Uuid
  employeeId          String     @db.Uuid
  salaryType          SalaryType
  monthlySalary       Decimal    @default(0) @db.Decimal(14, 2)
  dailyWage           Decimal    @default(0) @db.Decimal(14, 2)
  perPieceRate        Decimal    @default(0) @db.Decimal(14, 2)
  overtimeRatePerHour Decimal    @default(0) @db.Decimal(14, 2)
  effectiveFrom       DateTime   @db.Date
  effectiveTo         DateTime?  @db.Date
  isCurrent           Boolean    @default(true)
  reason              String?
  createdById         String?    @db.Uuid
  createdAt           DateTime   @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@index([companyId])
  @@map("salary_structures")
}

model EmploymentHistory {
  companyId     String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @db.Uuid
  changeType    String   @db.VarChar(40) // DESIGNATION, STATUS, TYPE ...
  fromValue     String?  @db.VarChar(120)
  toValue       String?  @db.VarChar(120)
  effectiveDate DateTime @db.Date
  notes         String?
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([companyId])
  @@map("employment_history")
}

model Attendance {
  companyId        String           @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id               String           @id @default(uuid()) @db.Uuid
  employeeId       String           @db.Uuid
  date             DateTime         @db.Date
  status           AttendanceStatus
  checkIn          DateTime?
  checkOut         DateTime?
  isLate           Boolean          @default(false)
  lateMinutes      Int              @default(0)
  isEarlyDeparture Boolean          @default(false)
  earlyMinutes     Int              @default(0)
  overtimeMinutes  Int              @default(0)
  notes            String?
  version          Int              @default(1)
  createdById      String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@index([companyId])
  @@map("attendance")
}

model LeaveRecord {
  companyId    String         @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id           String         @id @default(uuid()) @db.Uuid
  employeeId   String         @db.Uuid
  leaveType    LeaveType
  fromDate     DateTime       @db.Date
  toDate       DateTime       @db.Date
  days         Decimal        @db.Decimal(5, 1)
  reason       String?
  status       ApprovalStatus @default(PENDING)
  approvedById String?        @db.Uuid
