model PurchaseOrderItem {
  companyId        String  @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id               String  @id @default(uuid()) @db.Uuid
  purchaseOrderId  String  @db.Uuid
  fabricId         String  @db.Uuid
  quantity         Decimal @db.Decimal(12, 3)
  rate             Decimal @db.Decimal(14, 2)
  amount           Decimal @db.Decimal(14, 2)
  receivedQuantity Decimal @default(0) @db.Decimal(12, 3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
