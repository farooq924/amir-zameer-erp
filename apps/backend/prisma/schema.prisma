  createdAt    DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, fromDate])
  @@index([companyId])
  @@map("leave_records")
}

model OvertimeRecord {
  companyId     String         @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id            String         @id @default(uuid()) @db.Uuid
  employeeId    String         @db.Uuid
  date          DateTime       @db.Date
  hours         Decimal        @db.Decimal(5, 2)
  ratePerHour   Decimal        @db.Decimal(14, 2)
  amount        Decimal        @db.Decimal(14, 2)
  status        ApprovalStatus @default(PENDING)
  payrollItemId String?        @db.Uuid
  notes         String?
  createdById   String?        @db.Uuid
  createdAt     DateTime       @default(now())

  employee    Employee     @relation(fields: [employeeId], references: [id])
  payrollItem PayrollItem? @relation(fields: [payrollItemId], references: [id])

  @@index([employeeId, date])
  @@index([companyId])
  @@map("overtime_records")
}

model EmployeeAdvance {
  companyId         String        @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id                String        @id @default(uuid()) @db.Uuid
  advanceNo         String        @db.VarChar(30)
  employeeId        String        @db.Uuid
  advanceDate       DateTime      @db.Date
  amount            Decimal       @db.Decimal(14, 2)
  recoveredAmount   Decimal       @default(0) @db.Decimal(14, 2)
  balanceAmount     Decimal       @db.Decimal(14, 2)
  installmentAmount Decimal       @default(0) @db.Decimal(14, 2)
  paymentMethod     PaymentMethod @default(CASH)
  status            AdvanceStatus @default(OPEN)
  reason            String?
  idempotencyKey    String        @unique @db.VarChar(120)
  createdById       String?       @db.Uuid
  createdAt         DateTime      @default(now())

  employee   Employee          @relation(fields: [employeeId], references: [id])
  recoveries AdvanceRecovery[]

  @@unique([companyId, advanceNo])
  @@index([employeeId, status])
  @@index([companyId])
  @@map("employee_advances")
}

model AdvanceRecovery {
  companyId     String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id            String   @id @default(uuid()) @db.Uuid
  advanceId     String   @db.Uuid
  payrollItemId String?  @db.Uuid
  amount        Decimal  @db.Decimal(14, 2)
  recoveryDate  DateTime @db.Date
  createdAt     DateTime @default(now())

  advance     EmployeeAdvance @relation(fields: [advanceId], references: [id])
  payrollItem PayrollItem?    @relation(fields: [payrollItemId], references: [id])

  @@unique([advanceId, payrollItemId])
  @@index([companyId])
  @@map("advance_recoveries")
}

model Payroll {
  companyId       String        @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id              String        @id @default(uuid()) @db.Uuid
  payrollNo       String        @db.VarChar(30)
  periodKey       String        @db.VarChar(10) // "2026-11" - one payroll run per month
  periodStart     DateTime      @db.Date
  periodEnd       DateTime      @db.Date
  status          PayrollStatus @default(DRAFT)
  totalGross      Decimal       @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(14, 2)
  totalNet        Decimal       @default(0) @db.Decimal(14, 2)
  totalPaid       Decimal       @default(0) @db.Decimal(14, 2)
  approvedById    String?       @db.Uuid
  approvedAt      DateTime?
  notes           String?
  createdById     String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  approvedBy User?         @relation(fields: [approvedById], references: [id])
  items      PayrollItem[]

  @@unique([companyId, payrollNo])
  @@unique([companyId, periodKey])
  @@index([companyId])
  @@map("payrolls")
}

model PayrollItem {
  companyId        String     @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id               String     @id @default(uuid()) @db.Uuid
  payrollId        String     @db.Uuid
  employeeId       String     @db.Uuid
  periodKey        String     @db.VarChar(10)
  salaryType       SalaryType
  basicAmount      Decimal    @default(0) @db.Decimal(14, 2)
  presentDays      Decimal    @default(0) @db.Decimal(5, 1)
  absentDays       Decimal    @default(0) @db.Decimal(5, 1)
  completedPieces  Int        @default(0)
  pieceAmount      Decimal    @default(0) @db.Decimal(14, 2)
  overtimeAmount   Decimal    @default(0) @db.Decimal(14, 2)
  incentives       Decimal    @default(0) @db.Decimal(14, 2)
  bonus            Decimal    @default(0) @db.Decimal(14, 2)
  absenceDeduction Decimal    @default(0) @db.Decimal(14, 2)
  advanceDeduction Decimal    @default(0) @db.Decimal(14, 2)
  otherDeductions  Decimal    @default(0) @db.Decimal(14, 2)
  grossAmount      Decimal    @default(0) @db.Decimal(14, 2)
  netAmount        Decimal    @default(0) @db.Decimal(14, 2)
  paidAmount       Decimal    @default(0) @db.Decimal(14, 2)
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  payroll           Payroll            @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee          Employee           @relation(fields: [employeeId], references: [id])
  productionRecords ProductionRecord[]
  overtimeRecords   OvertimeRecord[]
  advanceRecoveries AdvanceRecovery[]
  payments          SalaryPayment[]

  @@unique([employeeId, periodKey]) // never two payrolls for the same employee & period
  @@index([companyId])
  @@map("payroll_items")
}

model SalaryPayment {
  companyId      String            @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id             String            @id @default(uuid()) @db.Uuid
  paymentNo      String            @db.VarChar(30)
  payrollItemId  String            @db.Uuid
  employeeId     String            @db.Uuid
  paymentDate    DateTime          @db.Date
  amount         Decimal           @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String?           @db.VarChar(100)
  idempotencyKey String            @unique @db.VarChar(120)
  status         TransactionStatus @default(POSTED)
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now())

  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])

  @@unique([companyId, paymentNo])
  @@index([employeeId, paymentDate])
  @@index([companyId])
  @@map("salary_payments")
}

// -----------------------------------------------------------------------------
// EXPENSES
// -----------------------------------------------------------------------------

model ExpenseCategory {
  companyId String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(80)
  accountId String?  @db.Uuid // expense account in chart of accounts
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   ChartOfAccount?    @relation(fields: [accountId], references: [id])
  expenses  Expense[]
  recurring RecurringExpense[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("expense_categories")
}

model Expense {
  companyId          String        @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id                 String        @id @default(uuid()) @db.Uuid
  expenseNo          String        @db.VarChar(30)
  expenseDate        DateTime      @db.Date
  categoryId         String        @db.Uuid
  description        String        @db.VarChar(300)
  amount             Decimal       @db.Decimal(14, 2)
  paymentMethod      PaymentMethod
  paidTo             String?       @db.VarChar(120)
  reference          String?       @db.VarChar(100)
  notes              String?
  status             ExpenseStatus @default(APPROVED)
  approvedById       String?       @db.Uuid
  approvedAt         DateTime?
  recurringExpenseId String?       @db.Uuid
  idempotencyKey     String        @unique @db.VarChar(120)
  version            Int           @default(1)
  createdById        String?       @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  category         ExpenseCategory   @relation(fields: [categoryId], references: [id])
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  createdBy        User?             @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedBy       User?             @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])

  @@unique([companyId, expenseNo])
  @@index([expenseDate])
  @@index([categoryId, expenseDate])
  @@index([companyId])
  @@map("expenses")
}

model RecurringExpense {
  companyId     String              @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id            String              @id @default(uuid()) @db.Uuid
  categoryId    String              @db.Uuid
  description   String              @db.VarChar(300)
  amount        Decimal             @db.Decimal(14, 2)
  paymentMethod PaymentMethod       @default(CASH)
  frequency     RecurrenceFrequency
  dayOfMonth    Int?
  nextRunDate   DateTime            @db.Date
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  expenses Expense[]

  @@index([companyId])
  @@map("recurring_expenses")
}

// -----------------------------------------------------------------------------
// CUSTOMER PAYMENTS & LEDGER
// -----------------------------------------------------------------------------

model Payment {
  companyId      String              @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id             String              @id @default(uuid()) @db.Uuid
  receiptNo      String              @db.VarChar(30)
  customerId     String              @db.Uuid
  orderId        String?             @db.Uuid
  paymentDate    DateTime            @default(now())
  amount         Decimal             @db.Decimal(14, 2) // always positive; REFUND type reduces paid
  method         PaymentMethod
  type           CustomerPaymentType
  reference      String?             @db.VarChar(100)
  idempotencyKey String              @unique @db.VarChar(120)
  status         TransactionStatus   @default(POSTED)
  reversalOfId   String?             @unique @db.Uuid
  notes          String?
  createdById    String?             @db.Uuid
  createdAt      DateTime            @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id])
  reversalOf Payment? @relation("PaymentReversal", fields: [reversalOfId], references: [id])
  reversedBy Payment? @relation("PaymentReversal")
  createdBy  User?    @relation(fields: [createdById], references: [id])

  @@unique([companyId, receiptNo])
  @@index([customerId, paymentDate])
  @@index([orderId])
  @@index([orderId, status], map: "payments_order_status_idx")
  @@index([paymentDate])
  @@index([companyId])
  @@map("payments")
}

/// Customer sub-ledger. Debit = customer owes more, Credit = customer paid / owes less.
model CustomerLedger {
  companyId     String          @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id            String          @id @default(uuid()) @db.Uuid
  customerId    String          @db.Uuid
  entryDate     DateTime        @db.Date
  entryType     LedgerEntryType
  referenceType String          @db.VarChar(40)
  referenceId   String          @db.Uuid
  description   String?
  debit         Decimal         @default(0) @db.Decimal(14, 2)
  credit        Decimal         @default(0) @db.Decimal(14, 2)
  createdAt     DateTime        @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([referenceType, referenceId, entryType])
  @@index([customerId, entryDate])
  @@index([companyId])
  @@map("customer_ledger")
}

// -----------------------------------------------------------------------------
// ACCOUNTING (double entry)
// -----------------------------------------------------------------------------

model ChartOfAccount {
  companyId     String      @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id            String      @id @default(uuid()) @db.Uuid
  code          String      @db.VarChar(20) // 1000 Cash, 4000 Stitching Revenue ...
  name          String      @db.VarChar(120)
  type          AccountType
  subType       String?     @db.VarChar(40) // CURRENT_ASSET, COGS, DIRECT_LABOUR, OPERATING_EXPENSE ...
  normalBalance BalanceSide
  parentId      String?     @db.Uuid
  isSystem      Boolean     @default(false)
  isActive      Boolean     @default(true)
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  parent            ChartOfAccount?    @relation("AccountTree", fields: [parentId], references: [id])
  children          ChartOfAccount[]   @relation("AccountTree")
  lines             JournalEntryLine[]
  expenseCategories ExpenseCategory[]

  @@unique([companyId, code])
  @@index([type])
  @@index([companyId])
  @@map("chart_of_accounts")
}

model AccountingPeriod {
  companyId  String       @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id         String       @id @default(uuid()) @db.Uuid
  name       String       @db.VarChar(40) // "Nov 2026"
  startDate  DateTime     @db.Date
  endDate    DateTime     @db.Date
  status     PeriodStatus @default(OPEN)
  closedById String?      @db.Uuid
  closedAt   DateTime?
  createdAt  DateTime     @default(now())

  journalEntries JournalEntry[]

  @@unique([companyId, startDate, endDate])
  @@unique([companyId, name])
  @@index([companyId])
  @@map("accounting_periods")
}

/// Posted entries are immutable (DB trigger); corrections use a reversal entry.
model JournalEntry {
  companyId    String        @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id           String        @id @default(uuid()) @db.Uuid
  entryNo      String        @db.VarChar(30)
  entryDate    DateTime      @db.Date
  periodId     String?       @db.Uuid
  description  String        @db.VarChar(300)
  sourceType   JournalSource
  sourceId     String?       @db.Uuid
  sourceKey    String?       @unique @db.VarChar(120) // e.g. "PAYMENT:<id>" - prevents double posting
  status       JournalStatus @default(DRAFT)
  totalDebit   Decimal       @default(0) @db.Decimal(14, 2)
  totalCredit  Decimal       @default(0) @db.Decimal(14, 2)
  reversalOfId String?       @unique @db.Uuid
  postedAt     DateTime?
  postedById   String?       @db.Uuid
  createdById  String?       @db.Uuid
  createdAt    DateTime      @default(now())

  period     AccountingPeriod?  @relation(fields: [periodId], references: [id])
  reversalOf JournalEntry?      @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy JournalEntry?      @relation("JournalReversal")
  createdBy  User?              @relation("JournalCreatedBy", fields: [createdById], references: [id])
  postedBy   User?              @relation("JournalPostedBy", fields: [postedById], references: [id])
  lines      JournalEntryLine[]

  @@unique([companyId, entryNo])
  @@index([entryDate])
  @@index([sourceType, sourceId])
  @@index([companyId])
  @@map("journal_entries")
}

model JournalEntryLine {
  companyId      String  @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id             String  @id @default(uuid()) @db.Uuid
  journalEntryId String  @db.Uuid
  lineNo         Int
  accountId      String  @db.Uuid
  debit          Decimal @default(0) @db.Decimal(14, 2)
  credit         Decimal @default(0) @db.Decimal(14, 2)
  description    String? @db.VarChar(300)
  customerId     String? @db.Uuid
  supplierId     String? @db.Uuid
  employeeId     String? @db.Uuid

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])
  customer     Customer?      @relation(fields: [customerId], references: [id])
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  employee     Employee?      @relation(fields: [employeeId], references: [id])

  @@unique([journalEntryId, lineNo])
  @@index([accountId])
  @@index([companyId])
  @@map("journal_entry_lines")
}

// -----------------------------------------------------------------------------
// WHATSAPP (official Meta Cloud API)
// -----------------------------------------------------------------------------

model WhatsAppTemplate {
  companyId   String   @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100) // Meta template name
  language    String   @default("en") @db.VarChar(10)
  category    String   @db.VarChar(30) // UTILITY, MARKETING ...
  purpose     String   @db.VarChar(40) // ORDER_CONFIRMATION, ORDER_READY ...
  bodyPreview String
  variables   Json     @default("[]")
  metaStatus  String?  @db.VarChar(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages WhatsAppMessage[]

  @@unique([companyId, name, language])
  @@index([companyId])
  @@map("whatsapp_templates")
}

model WhatsAppMessage {
  companyId    String         @default(dbgenerated("az_require_company()")) @db.Uuid // tenant (company) - set automatically, see common/tenant
  id           String         @id @default(uuid()) @db.Uuid
  customerId   String?        @db.Uuid
  toNumber     String         @db.VarChar(20)
  templateId   String?        @db.Uuid
  channel      MessageChannel @default(CLOUD_API)
  messageType  String         @db.VarChar(20) // TEMPLATE | TEXT | DOCUMENT
  body         String?
  payload      Json?
  status       MessageStatus  @default(QUEUED)
  waMessageId  String?        @unique @db.VarChar(120)
  attempts     Int            @default(0)
  nextRetryAt  DateTime?
  errorCode    String?        @db.VarChar(40)
  errorMessage String?
  relatedType  String?        @db.VarChar(40)
  relatedId    String?        @db.Uuid
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  createdById  String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  customer Customer?         @relation(fields: [customerId], references: [id])
  template WhatsAppTemplate? @relation(fields: [templateId], references: [id])

  @@index([status, nextRetryAt])
  @@index([customerId])
  @@index([companyId])
  @@map("whatsapp_messages")
}

model WhatsAppWebhookEvent {
  id         String   @id @default(uuid()) @db.Uuid
  payload    Json
  processed  Boolean  @default(false)
  error      String?
  receivedAt DateTime @default(now())

  @@index([processed])
  @@map("whatsapp_webhook_events")
}
